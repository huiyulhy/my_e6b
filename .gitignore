# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.pytest_cache/
.ruff_cache/

# Source data for the build scripts, not the build output. The raw FAA NASR
# cycle is ~1 GB and is reissued every 28 days; `data/aero/airports.sqlite`
# is the 3 MB artefact built from it and *is* committed, since that is what
# the app ships with offline.
.cache/
data/nasr/

# FAA raster charts. The source GeoTIFFs under data/charts/<sectional|tac>/
# are committed: they are the data, reissued every 56 days, and what every
# tile is derived from. Download them by hand (data/charts/README.txt).
#
# The tiles are not. They are build output, rebuilt from the sources by
# `make charts` in about a minute, and committing them would store the same
# charts twice -- once as the GeoTIFF and once as a few thousand PNGs of it.
data/charts/tiles/

# Tiles the dev server renders as you pan go here instead of beside the
# build output, so the two never mix. Already covered by .cache/ above;
# named explicitly because it is easy to miss where they land.
.cache/chart-tiles/
